#!/usr/bin/env bash

declare -A DEPENDENT_CONTAINERS=(
    ["gluetun"]="qbittorrent qbittorrent-age-tagger"
    ["mariadb"]="homeassistant kodi"
    ["mosquitto"]="zigbee2mqtt"
    ["victoriametrics"]="grafana"
    ["victorialogs"]="grafana"
)

# Distroless containers that have no package manager to patch
DISTROLESS_PREFIXES=( "cloudflare" "victoria" )

# Initialize all script-level variables so set -u (nounset) doesn't fail
APT_CMD="" CONTAINER="" CONTAINER_PREFIX="" DEPENDENT="" \
    ITEMS="" OS_RELEASE="" PRIORITY="" RESTART_TARGET="" RELEASE="" \
    USER=""

error() { printf '%s\n' "$1" >&2; }

check_alpine_privs() {
    docker exec "$CONTAINER" sh -c '
        [ "$(id -u)" -eq 0 ] && [ -w /lib/apk/db ]
    ' >/dev/null 2>&1
}

check_debian_privs() {
    local USER
    USER=$(docker exec "$CONTAINER" sh -c 'whoami' | tr -d '\r\n')
    if [[ "$USER" == "root" ]]; then
        return 0
    fi
    local SUDO
    SUDO=$(docker exec "$CONTAINER" sh -c 'which sudo' || true)
    [[ -n "$SUDO" ]]
}

patch_alpine() {
    local ITEMS
    if ! check_alpine_privs; then
        error "'$CONTAINER' cannot run 'apk': not root or apk database not writable"
        return
    fi
    echo ">>> Updating package list for '$CONTAINER'..."
    local UPDATE_OK
    UPDATE_OK=$(docker exec "$CONTAINER" sh -c 'apk update >/dev/null 2>&1' && echo "yes" || echo "no")
    if [[ "$UPDATE_OK" == "no" ]]; then
        error "'$CONTAINER' failed to update package list"
        return
    fi
    ITEMS=$(docker exec "$CONTAINER" sh -c 'apk -u list 2>/dev/null' | grep upgradable | wc -l)
    if [[ "$ITEMS" -gt 0 ]]; then
        echo ">>> Installing updates for '$CONTAINER'..."
        if docker exec "$CONTAINER" sh -c "apk upgrade && find /usr/lib -regex '^.*\(__pycache__\|\.py[co]\)$' -delete && rm -rf /var/cache/apk/*"; then
            restart_container
            check_priority
        else
            error "'$CONTAINER' failed to install updates"
        fi
    fi
}

patch_debian() {
    local APT_CMD="apt"
    local USER
    USER=$(docker exec "$CONTAINER" sh -c 'whoami' | tr -d '\r\n')
    if [[ "$USER" != "root" ]]; then
        if ! check_debian_privs; then
            error "'$CONTAINER' cannot run 'apt': not root or sudo not available"
            return
        fi
        APT_CMD="sudo apt"
    fi

    echo ">>> Updating package list for '$CONTAINER'..."
    local UPDATE_OK
    UPDATE_OK=$(docker exec "$CONTAINER" sh -c "$APT_CMD update >/dev/null 2>&1" && echo "yes" || echo "no")
    if [[ "$UPDATE_OK" == "no" ]]; then
        error "'$CONTAINER' failed to update package list"
        return
    fi
    local ITEMS
    ITEMS=$(docker exec "$CONTAINER" sh -c "$APT_CMD list --upgradable 2>/dev/null" | grep upgradable | wc -l) || true
    if [[ "$ITEMS" -gt 0 ]]; then
        echo ">>> Installing updates for '$CONTAINER'..."
        if docker exec "$CONTAINER" sh -c "export DEBIAN_FRONTEND=noninteractive && $APT_CMD upgrade -y && $APT_CMD clean autoclean && $APT_CMD autoremove -y"; then
            restart_container
            check_priority
        else
            error "'$CONTAINER' failed to install updates"
        fi
    else
        echo ">>> No packages to update for '$CONTAINER'"
    fi
}

restart_container() {
    echo -e "\n>>> Restarting container '$CONTAINER' after installing updates ..."
    docker restart "$CONTAINER"
}

check_priority() {
    if [[ " ${!DEPENDENT_CONTAINERS[@]} " =~ " $CONTAINER " ]]; then
        for RESTART_TARGET in ${DEPENDENT_CONTAINERS[$PRIORITY]}; do
            echo -e "\n>>> Restarting container '$RESTART_TARGET' due to '$CONTAINER' restart ..."
            docker restart "$RESTART_TARGET"
        done
    fi
}

find_release() {
    local OS_RELEASE
    OS_RELEASE=$(docker exec "$CONTAINER" sh -c 'cat /etc/os-release')
    RELEASE=$(echo "$OS_RELEASE" | awk -F= '$1=="ID" { print $2 ;}' | tr -d '[:cntrl:]')

    # if /etc/os-release was not present, check with uname
    if [[ -z "$RELEASE" ]]; then
        OS_RELEASE=$(docker exec "$CONTAINER" sh -c 'uname -r')
        if [[ "$OS_RELEASE" == *generic* ]]; then
            RELEASE="generic"
        else
            error "Unexpected release type '$OS_RELEASE' for container '$CONTAINER'"
            return 1
        fi
    fi
}

is_distroless() {
    local CONTAINER_PREFIX
    for CONTAINER_PREFIX in "${DISTROLESS_PREFIXES[@]}"; do
        [[ "$CONTAINER" == "${CONTAINER_PREFIX}"* ]] && return 0
    done
    return 1
}

get_release_and_patch_server() {
    if is_distroless; then
        echo -e "\n>>> Container '$CONTAINER' is distroless, skipping...\n"
        return
    fi
    find_release
    if [[ -n "$RELEASE" ]]; then
        echo -e "\n>>> Container '$CONTAINER' is running OS release '$RELEASE'.\n"
        if [[ "$RELEASE" == 'alpine' || "$RELEASE" == 'generic' ]]; then
            patch_alpine
        elif [[ "$RELEASE" == 'debian' || "$RELEASE" == 'ubuntu' ]]; then
            patch_debian
        else
            error "Release type '$RELEASE' for container '$CONTAINER' is not currently supported"
        fi
    else
        error "Failed to retrieve release for '$CONTAINER'"
    fi
}

for PRIORITY in "${!DEPENDENT_CONTAINERS[@]}"; do
    if docker ps --format "{{.Names}}" | grep -q "$PRIORITY"; then
        for DEPENDENT in ${DEPENDENT_CONTAINERS[$PRIORITY]}; do
            if docker ps --format "{{.Names}}" | grep -q "$DEPENDENT"; then
                CONTAINER=$DEPENDENT
                get_release_and_patch_server
            fi
        done
        CONTAINER=$PRIORITY
        get_release_and_patch_server
    fi
done

for CONTAINER in $(docker ps --format "{{.Names}}"); do
    if ! [[ "${!DEPENDENT_CONTAINERS[@]}" =~ "$CONTAINER" ]] && ! [[ "${DEPENDENT_CONTAINERS[*]}" =~ "$CONTAINER" ]]; then
        get_release_and_patch_server
    fi
done

unset APT_CMD CONTAINER CONTAINER_PREFIX DEPENDENT ITEMS OS_RELEASE PRIORITY \
    RESTART_TARGET RELEASE USER
